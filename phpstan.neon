includes:
    - vendor/larastan/larastan/extension.neon
    - vendor/calebdw/larastan-livewire/extension.neon
    - vendor/canvural/larastan-strict-rules/rules.neon
    - vendor/phpstan/phpstan-strict-rules/rules.neon

parameters:
    level: 10
    # PHPStan's result cache defaults to a directory under the system temp
    # directory, which a fresh runner never has and which CI therefore cannot
    # restore. Naming it puts the cache somewhere actions/cache can carry
    # between runs, so unchanged files are not re-analysed. It also lands for
    # PhpStanBoundaryRuleTest, which shells out to PHPStan over the whole
    # Modules tree from inside the suite and paid the full price every run.
    tmpDir: .phpstan-cache
    # phpstan 2.2.x intermittently crashes its parallel workers with
    # phar-include failures when it fans out to many processes inside the
    # Docker toolchain (8+ cores). Capping the worker count keeps the
    # quality gate deterministic at a negligible speed cost.
    parallel:
        maximumNumberOfProcesses: 4
    # The nativephp/mobile-* packages live only in mobile-app/vendor, so the
    # repo-root toolchain cannot autoload them and every call through them
    # types as `mixed` — which makes the fluent scanner builder uncheckable,
    # the opposite of what level 10 is for. scanFiles (not stubFiles, which
    # only override symbols that already resolve) hands PHPStan the real
    # signatures so those calls are genuinely analysed. The file is never
    # autoloaded at runtime — it lives outside every composer PSR-4 root — so
    # the class_exists() guards that gate every native call stay false here
    # and on the desktop build.
    scanFiles:
        - tools/phpstan-stubs/native-mobile-scanner.php
        - tools/phpstan-stubs/native-mobile-edge.php
    paths:
        - Modules
        - app
        - bootstrap/app.php
    excludePaths:
        analyse:
            - Modules/*/Database/Migrations/*
            - Modules/*/Database/Seeders/*
            - Modules/*/Routes/*
            - Modules/*/tests/*
            - app/PhpStan/Rules/Fixtures/*
            - database/migrations/*
            - tests/*
            # NativePHP's published plugin-registration stub
            # (nativephp/mobile's resources/stubs/NativeServiceProvider.php.stub,
            # scaffolded via `php artisan native:plugin:register`). Its
            # `plugins()` return type names the mobile plugin provider classes
            # (`Native\Mobile\Providers\*`, `NativePHP\BackgroundTasks\*`)
            # verbatim per the vendor contract; those packages are installed
            # ONLY in `mobile-app/vendor` (the sibling-root topology —
            # `nativephp/desktop` conflicts with `nativephp/mobile`), never in
            # this repo-root toolchain, so they are permanently unresolvable
            # here — mirrors why `mobile-app/bootstrap/app.php` (a real, never
            # symlinked file) is likewise outside these paths. Registered
            # exclusively from `mobile-app/bootstrap/providers.php`; the
            # desktop root's own manifest never loads this provider.
            - app/Providers/NativeServiceProvider.php
            # NativePHP desktop's published app-provider stub, scaffolded by
            # `php artisan native:install` (re-run by the composer
            # `post-update-cmd` hook, so it is regenerated on every update and
            # cannot be durably edited or deleted). It is NOT registered in
            # either `bootstrap/providers.php` — the real desktop native
            # provider is `Modules/Desktop/Internal/NativeAppServiceProvider`,
            # which owns window composition and carries the Native\Desktop
            # facade allow-list. This stray stub only calls `Window::open()`
            # and returns an untyped phpIni() array; excluded here for the
            # same reason as the mobile NativeServiceProvider stub above.
            - app/Providers/NativeAppServiceProvider.php
    reportUnmatchedIgnoredErrors: true
    ignoreErrors:
        # Single permitted facade + config() use in module code: the
        # Cache::store() call and the config('cache.locks_store') read inside
        # LockStore::forUniqueJobs(). Laravel's queue infrastructure invokes
        # ShouldBeUniqueUntilProcessing::uniqueVia() at queue-push time before
        # constructor DI completes, so a constructor-injected Repository is not
        # reachable from a uniqueVia() body. The BoundaryArchTest "no Laravel
        # facade usage in module code" test enforces the same carve-out via
        # pest-plugin-arch's ignoring() list, confined to this one file.
        -
            message: '#Illuminate\\Support\\Facades\\Cache facade should not be used\.#'
            path: Modules/Core/Public/Support/LockStore.php
        -
            message: "#Global helper function 'config' should not be used\\.#"
            path: Modules/Core/Public/Support/LockStore.php
        # HorizonServiceProvider::boot() gates the /horizon dashboard on
        # config('app.dev_mode'). A service provider's boot() is the
        # canonical Laravel idiom for reading config — the laravel/horizon
        # package provider it extends reads config the same way — and a
        # constructor-injected Repository is not the established pattern
        # for the framework's published HorizonServiceProvider stub.
        -
            message: "#Global helper function 'config' should not be used\\.#"
            path: app/Providers/HorizonServiceProvider.php
        # Native-chrome carve-out: NativePHP's window, app-menu,
        # OS-theme, and notification API is only reachable through its
        # facades, which NativePHP invokes outside the container
        # lifecycle — there is no constructor-injection seam for them.
        # The crossing is confined to the desktop module's native-chrome
        # classes (the NativePHP-booted provider, the AppMenuBuilder,
        # the OsThemeProbe that wraps `System::theme()` behind the
        # `OsThemeSignal` Public contract, and the
        # `DispatchOsNotification` listener that fires the OS
        # notifications via `Notification::title()->message()
        # ->event()->reference()->show()`). The BoundaryArchTest "no
        # Laravel facade usage in module code" test mirrors this
        # allow-list.
        #
        # The macOS menu-bar tray is intentionally NOT a member
        # of this carve-out — the persistent tray is created in the
        # Electron main process by `scripts/nativephp_inject_persistent_tray.php`
        # rather than through any PHP-side facade, so no PHP module
        # code needs the `MenuBar` facade.
        #
        # The larastan-strict-rules `noFacadeRule` flags every
        # `Native\Desktop\Facades\X::y()` call individually; the message
        # shape is `Native\Desktop\Facades\<Facade> facade should not be
        # used.` — a single regex covers all four facades the carve-out
        # admits (Menu, Window, System, Notification, App).
        -
            message: '#Native\\Desktop\\Facades\\(Menu|Window|System|Notification|App|ChildProcess) facade should not be used\.#'
            paths:
                - Modules/Desktop/Internal/NativeAppServiceProvider.php
                - Modules/Desktop/Internal/Native/AppMenuBuilder.php
                - Modules/Desktop/Internal/Native/OsThemeProbe.php
                - Modules/Desktop/Internal/Native/NativeBiometricUnlock.php
                - Modules/Desktop/Internal/Native/DesktopKeyCustodian.php
                - Modules/Desktop/Internal/Native/SyncListenerProcess.php
                - Modules/Desktop/Internal/Native/RelayListenerProcess.php
                - Modules/Desktop/Internal/Listeners/DispatchOsNotification.php
                - Modules/Desktop/Internal/Listeners/SurfaceWorkerCrashAlert.php
                - Modules/Desktop/Internal/Listeners/NavigateOnNotificationDeepLink.php
                - Modules/Desktop/Internal/Listeners/ApplyCloseWindowChoice.php
            reportUnmatched: false
        # The `Notification` facade docblock declares its chained
        # builder methods (`title`, `message`, `event`, `reference`,
        # `show`) as `@method static static …`, so the fluent chain
        # `Notification::title(…)->message(…)->event(…)->reference(…)
        # ->show()` triggers `staticMethod.dynamicCall` on every link
        # after the first. The chain matches NativePHP's documented
        # API verbatim — we cannot refactor it.
        -
            message: '#Dynamic call to static method Native\\Desktop\\Facades\\Notification::(message|event|reference|show)\(\)\.#'
            paths:
                - Modules/Desktop/Internal/Listeners/DispatchOsNotification.php
                - Modules/Desktop/Internal/Listeners/SurfaceWorkerCrashAlert.php
            reportUnmatched: false
        # `Window::open()` returns `PendingOpenWindow|void` per the
        # facade docblock (the contract method has no return type), so
        # the fluent chain `->width()->height()->rememberState()` is
        # untyped at the call site. The `WindowManager::open()` contract
        # is a NativePHP API shape we do not own; type-narrowing at the
        # call site would force an `assert(...)` we cannot easily express
        # without leaking NativePHP internals.
        -
            message: '#Cannot call method (width|height|rememberState)\(\) on mixed\.#'
            path: Modules/Desktop/Internal/NativeAppServiceProvider.php
            reportUnmatched: false
        # `Window::current()` is typed as returning `object` by the
        # facade docblock (NativePHP's WindowManager facade signature
        # — we do not own it). The notification deep-link listener
        # navigates the focused window via `Window::current()->url($route)`;
        # the close-action listener hides it via `->hide()`. Both are
        # the canonical NativePHP API shapes; no constructor-injection
        # seam exists.
        -
            message: '#Call to an undefined method object::(url|hide)\(\)\.#'
            paths:
                - Modules/Desktop/Internal/Listeners/NavigateOnNotificationDeepLink.php
                - Modules/Desktop/Internal/Listeners/ApplyCloseWindowChoice.php
            reportUnmatched: false
        # Mobile native-facade carve-out (mirrors the Native\Desktop\
        # Facades allow-list above): nativephp/mobile's Network/Biometrics/
        # Scanner API is only reachable through its facades. Registered up
        # front (single-owner forward-registration) so adding the first
        # actual facade call never needs to touch this file — the crossing
        # is confined to the Mobile module's native-bridge classes.
        # reportUnmatched: false because no file yet contains a matching
        # facade call (the nativephp/mobile-* packages are not installed
        # in this root).
        -
            message: '#Native\\Mobile\\Facades\\(Network|Biometrics|Scanner|SecureStorage|Device) facade should not be used\.#'
            paths:
                - Modules/Mobile/Internal/NativeMobileAppServiceProvider.php
                - Modules/Mobile/Internal/Identity/*.php
                - Modules/Mobile/Internal/Native/*.php
                - Modules/Mobile/Internal/Pairing/*.php
                - Modules/Mobile/Internal/Sync/*.php
            reportUnmatched: false
        # Same carve-out for the classes themselves: `Native\Mobile\*` ships
        # only in mobile-app/vendor, so this root cannot see it. The call
        # sites are all class_exists-guarded and bound only under the mobile
        # runtime, exactly like the SecureStorage custodian above.
        -
            message: '#(Call to static method [a-zA-Z]+\(\) on an unknown class Native\\Mobile\\Facades\\[A-Za-z]+|has invalid return type Native\\Mobile|used in class_exists is not a valid class name)#'
            paths:
                - Modules/Mobile/Internal/Native/*.php
            reportUnmatched: false
        # `Internal/Listeners/` is a genuinely NEW sanctioned crossing
        # point in this same carve-out family — the mobile delivery adapter
        # (`DispatchMobileNotification`, the mobile notification mirror) reaches
        # `nativephp/mobile-local-notifications`'s `LocalNotifications`
        # facade, which lives only in `mobile-app/vendor` (never this
        # toolchain), exactly like the Network/Biometrics/Scanner/
        # SecureStorage facades above. Single-owner forward-registration:
        # this is the one file in that directory today; a future listener
        # added to `Internal/Listeners/` reuses this same path glob.
        # reportUnmatched: false because no file the main analysis sees
        # contains a matching call target (the plugin is unresolvable here).
        -
            message: '#NativePHP\\LocalNotifications\\Facades\\LocalNotifications facade should not be used\.#'
            paths:
                - Modules/Mobile/Internal/Listeners/*.php
            reportUnmatched: false
        # Livewire's upload-URL facade, in the one place the mobile bridge can
        # reach it. `swap()` is the whole point of the call and has no
        # container equivalent: it sets the facade's resolved-instance cache as
        # well as the binding, and under `runningUnitTests()` Livewire has
        # already put a stub of its own in that cache
        # (SupportFileUploads::provide()). Binding alone leaves the stub
        # winning for every caller that goes through the facade — which is how
        # Livewire itself mints the URL. Not a testability loss either: the
        # swapped-in generator is an ordinary injectable class, and
        # BridgeSignedUploadUrlTest asserts against the facade root directly.
        # The BoundaryArchTest facade scan does not cover this because
        # `Livewire\Facades` is not `Illuminate\Support\Facades`; larastan's
        # noFacadeRule flags it only because it extends Illuminate's base.
        -
            message: '#Livewire\\Facades\\GenerateSignedUploadUrlFacade facade should not be used\.#'
            path: Modules/Mobile/Providers/MobileServiceProvider.php
        # First-party cold-start biometric-vault plugin facade (spike). Same
        # carve-out rationale as the nativephp/mobile facades above: the plugin
        # lives only in mobile-app/vendor, so the enclave-gated vault is reached
        # through its facade, confined to the Mobile identity bridge classes,
        # each call class_exists()-guarded. reportUnmatched:false until the
        # plugin is wired into the build.
        -
            message: '#Beatrax\\BiometricVault\\Facades\\BiometricVault facade should not be used\.#'
            paths:
                - Modules/Mobile/Internal/Identity/*.php
            reportUnmatched: false
        # Mobile wire-protocol carve-out: the phone's
        # client-only LAN transport (LanSyncClient) and its KEK-gated
        # trigger orchestrator (MobileSyncTriggerService) MUST reuse the
        # desktop's sync transport byte-for-byte — the Noise IK handshake
        # state machine, PeerCatchUpExchanger's catch-up constants,
        # TransportFramer framing, SyncSession's auth-gate + replay, the
        # OpLogReplayer/MergeRulesRegistry merge, the device identity
        # loader, and the relay client — per the documented boundary that the
        # wire protocol is consumed as-is with no redesign. These are
        # transport/crypto/merge internals, not a general-purpose
        # cross-module API, so no Modules\Sync\Public re-export exists (nor
        # should one). The crossing is confined to the Mobile module's own
        # sync-transport classes.
        -
            message: '#Cross-module Internal/Models import forbidden: Mobile cannot use Modules\\Sync\\Internal\\(Config\\MergeRulesRegistry|Identity\\(DeviceIdentityDto|DeviceIdentityLoader)|Merge\\OpLogReplayer|Signing\\DeviceKeySigner|Transport\\(Frame\\TransportFramer|Noise\\(NoiseHandshakeState|NoiseSession)|PeerCatchUpExchanger|SyncSession|Relay\\(RelayClient|RelayConfig)))#'
            path: Modules/Mobile/Internal/Sync/*.php
            reportUnmatched: false
    allowedGlobalFunctions:
        - 'app_path'
        - 'base_path'
        - 'config_path'
        - 'database_path'
        - 'resource_path'
        - 'storage_path'
        - 'public_path'
    # Restrict the `Listeners handle method should have 'void' return type`
    # check (canvural/larastan-strict-rules) to actual Listener directories.
    # With the upstream default of `[]` the rule matches every class with a
    # `handle()` method (middleware, commands, jobs) which is wrong.
    listenerPaths:
        - Modules/*/Internal/Listeners
        - Modules/*/Public/Listeners

rules:
    - App\PhpStan\Rules\BoundaryRule

includes:
    - vendor/larastan/larastan/extension.neon
    - vendor/calebdw/larastan-livewire/extension.neon
    - vendor/canvural/larastan-strict-rules/rules.neon
    - vendor/phpstan/phpstan-strict-rules/rules.neon

parameters:
    level: max
    paths:
        - Modules
        - app
        - bootstrap/app.php
    excludePaths:
        analyse:
            - Modules/*/Database/Migrations/*
            - Modules/*/Database/Seeders/*
            - Modules/*/Routes/*
            - Modules/*/tests/*
            - app/PhpStan/Rules/Fixtures/*
            - database/migrations/*
            - tests/*
    reportUnmatchedIgnoredErrors: true
    ignoreErrors:
        # Single permitted facade + config() use in module code: the
        # Cache::store() call and the config('cache.locks_store') read inside
        # LockStore::forUniqueJobs(). Laravel's queue infrastructure invokes
        # ShouldBeUniqueUntilProcessing::uniqueVia() at queue-push time before
        # constructor DI completes, so a constructor-injected Repository is not
        # reachable from a uniqueVia() body. The BoundaryArchTest "no Laravel
        # facade usage in module code" test enforces the same carve-out via
        # pest-plugin-arch's ignoring() list, confined to this one file.
        -
            message: '#Illuminate\\Support\\Facades\\Cache facade should not be used\.#'
            path: Modules/Core/Public/Support/LockStore.php
        -
            message: "#Global helper function 'config' should not be used\\.#"
            path: Modules/Core/Public/Support/LockStore.php
    allowedGlobalFunctions:
        - 'app_path'
        - 'base_path'
        - 'config_path'
        - 'database_path'
        - 'resource_path'
        - 'storage_path'
        - 'public_path'
    # Restrict the `Listeners handle method should have 'void' return type`
    # check (canvural/larastan-strict-rules) to actual Listener directories.
    # With the upstream default of `[]` the rule matches every class with a
    # `handle()` method (middleware, commands, jobs) which is wrong.
    listenerPaths:
        - Modules/*/Internal/Listeners
        - Modules/*/Public/Listeners

rules:
    - App\PhpStan\Rules\BoundaryRule

includes:
    - vendor/larastan/larastan/extension.neon
    - vendor/calebdw/larastan-livewire/extension.neon
    - vendor/canvural/larastan-strict-rules/rules.neon
    - vendor/phpstan/phpstan-strict-rules/rules.neon

parameters:
    level: max
    paths:
        - Modules
        - app
        - bootstrap/app.php
    excludePaths:
        analyse:
            - Modules/*/Database/Migrations/*
            - Modules/*/Database/Seeders/*
            - Modules/*/Routes/*
            - Modules/*/tests/*
            - app/PhpStan/Rules/Fixtures/*
            - database/migrations/*
            - tests/*
    reportUnmatchedIgnoredErrors: true
    ignoreErrors:
        # Single permitted facade use in module code: the Cache::driver('redis')
        # call inside ResolveChainLinksJob::uniqueVia(). Laravel's queue
        # infrastructure invokes uniqueVia() at queue-push time before
        # constructor DI completes, so a constructor-injected Repository
        # is not an option. The BoundaryArchTest "no Laravel facade usage
        # in module code" test enforces the same carve-out via
        # pest-plugin-arch's ignoring() list. See 05-RESEARCH Pattern 3
        # "Note on facade exception".
        -
            message: '#Illuminate\\Support\\Facades\\Cache facade should not be used\.#'
            path: Modules/Chains/Internal/Jobs/ResolveChainLinksJob.php
        # Same carve-out for the EmailScan queued jobs: Laravel's queue
        # infrastructure calls uniqueVia() at push-time before
        # constructor DI resolves, so the Cache facade is the only way
        # to hand a Repository back to the unique-lock middleware. The
        # BoundaryArchTest "no Laravel facade usage in module code" rule
        # mirrors this allow-list via pest-plugin-arch's ignoring().
        -
            message: '#Illuminate\\Support\\Facades\\Cache facade should not be used\.#'
            path: Modules/EmailScan/Internal/Jobs/BackfillInboxJob.php
        -
            message: '#Illuminate\\Support\\Facades\\Cache facade should not be used\.#'
            path: Modules/EmailScan/Internal/Jobs/IncrementalScanJob.php
        # DiscoveryScanJob carve-out lands in Plan 09 when the class ships.
    allowedGlobalFunctions:
        - 'app_path'
        - 'base_path'
        - 'config_path'
        - 'database_path'
        - 'resource_path'
        - 'storage_path'
        - 'public_path'
    # Restrict the `Listeners handle method should have 'void' return type`
    # check (canvural/larastan-strict-rules) to actual Listener directories.
    # With the upstream default of `[]` the rule matches every class with a
    # `handle()` method (middleware, commands, jobs) which is wrong.
    listenerPaths:
        - Modules/*/Internal/Listeners
        - Modules/*/Public/Listeners

rules:
    - App\PhpStan\Rules\BoundaryRule

# Server deployment env for deploy/server/docker-compose.yml.
# Copy to deploy/server/.env and fill in. Every app process (app/queue/
# scheduler) reads THIS file via env_file, so it is the single source of truth
# — set APP_KEY here (generate with `... run --rm app php artisan key:generate
# --show`), then run `... exec app php artisan beatrax:install`.
APP_NAME=Beatrax
APP_ENV=production
APP_DEBUG=false
APP_KEY=

# The URL you actually reach this install at. Its host is load-bearing twice:
# TrustedHostGuard admits it, and it is what authorises a remote request under
# FrankenPHP, which publishes no bind address for the address gate to read.
# Left on localhost, this install stays reachable from this machine only.
APP_URL=http://localhost:8000

# Nothing here is reachable from another machine until this names the
# interfaces you serve on — comma-separated literal IP addresses, matched
# against the published bind address. Unset refuses every non-loopback request
# with not-found. Wildcards, CIDR ranges and hostnames are ignored and named
# back by `php artisan beatrax:doctor`. See .docs/deployment.md.
# BEATRAX_SERVED_INTERFACES=192.168.1.50

# Host port the app (FrankenPHP) is published on.
HTTP_PORT=8000

# SQLite is the only supported database, in every deployment shape — the
# schema uses SQLite-only triggers and an FTS5 search table (ADR-0022). There
# is no database server here and no password to set.
# The path sits on the app-data volume so it survives `down` and rebuilds.
DB_CONNECTION=sqlite
DB_DATABASE=/app/database/database.sqlite

QUEUE_CONNECTION=database
CACHE_STORE=database
SESSION_DRIVER=database

# Containers: log to stderr so `docker compose logs` shows everything (the
# default `daily` writes to storage/logs, which is ephemeral in a container).
LOG_CHANNEL=stderr

# Dev Console / dev tools stay OFF on a server. Horizon is a dev-only
# dependency (excluded by `composer install --no-dev`); the queue runs on the
# database driver via the `queue` service — no Redis required.
BEATRAX_DEV_MODE=false

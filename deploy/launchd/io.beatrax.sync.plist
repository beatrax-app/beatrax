<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple Computer//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!--
    LaunchAgent: beatrax Noise/WebSocket sync listener (self-host fallback, D-03).

    Runs `php artisan sync:serve` as a long-running amphp event-loop daemon that
    accepts Noise-authenticated WebSocket connections from paired devices on the
    same LAN (XPORT-01/02, D-03/D-04).

    This launchd template is the FALLBACK host for the sync daemon — the PRIMARY
    host is the NativePHP ChildProcess (started automatically by the packaged
    desktop app). Use this plist when running beatrax outside the packaged app
    (self-hosters, headless server installs, development).

    Placeholders — same substitution shape as the scheduler + horizon plists.
    The InstallCommand --launchd path (or a manual `sed` step) swaps both
    placeholders at install time:
        {{ABS_PHP_BINARY}}    → absolute path to the PHP 8.5 binary (e.g. /opt/homebrew/bin/php)
        {{ABS_PROJECT_ROOT}}  → absolute path to the beatrax project root

    relay:serve (the ZK relay endpoint) is intentionally NOT included here.
    The relay is opt-in (D-01): self-hosters who want to run a relay start it
    manually (`php artisan relay:serve`) or create a separate LaunchAgent following
    the same structure as this plist, substituting `relay:serve` for `sync:serve`.

    KeepAlive + ThrottleInterval match the scheduler + horizon plists so a
    misbehaving sync listener cannot spin in a tight crash-restart loop.
-->
<plist version="1.0">
<dict>
    <key>Label</key>
    <string>io.beatrax.sync</string>

    <key>ProgramArguments</key>
    <array>
        <string>{{ABS_PHP_BINARY}}</string>
        <string>{{ABS_PROJECT_ROOT}}/artisan</string>
        <string>sync:serve</string>
    </array>

    <key>WorkingDirectory</key>
    <string>{{ABS_PROJECT_ROOT}}</string>

    <key>RunAtLoad</key>
    <true/>

    <key>KeepAlive</key>
    <dict>
        <key>Crashed</key>
        <true/>
        <key>SuccessfulExit</key>
        <false/>
    </dict>

    <key>ThrottleInterval</key>
    <integer>10</integer>

    <key>StandardOutPath</key>
    <string>{{ABS_PROJECT_ROOT}}/storage/logs/launchd-sync.log</string>

    <key>StandardErrorPath</key>
    <string>{{ABS_PROJECT_ROOT}}/storage/logs/launchd-sync.err.log</string>

    <key>EnvironmentVariables</key>
    <dict>
        <key>PATH</key>
        <string>/usr/local/bin:/usr/bin:/bin:/opt/homebrew/bin</string>
    </dict>
</dict>
</plist>

/.phpunit.cache
/node_modules
/public/build
/public/hot
/public/storage

# Laravel-generated bootstrap caches — package discovery, compiled
# services, config, routes and module manifests. These are regenerated
# per environment and must never be committed: a cache generated with
# the full (dev) dependency tree references provider classes (e.g.
# Horizon's transitive laravel/sentinel) that are absent from a
# `--no-dev` packaged build, which fatals the app at boot.
/bootstrap/cache/*.php
/storage/*.key
/storage/app/private
/storage/app/public
/storage/app/dev_mode
/storage/app/inbox
/storage/app/backups
/storage/app/sync
/storage/app/secrets
/storage/app/first-launch.app-key-generated
/storage/framework/cache/*
!/storage/framework/cache/.gitignore
/storage/framework/sessions/*
!/storage/framework/sessions/.gitignore
/storage/framework/testing/*
!/storage/framework/testing/.gitignore
/storage/framework/views/*
!/storage/framework/views/.gitignore
/storage/logs/*
!/storage/logs/.gitignore
/storage/pail
/vendor
.env
.env.backup
.env.bak
.env.production
.phpactor.json
.phpunit.result.cache
auth.json
Homestead.json
Homestead.yaml
npm-debug.log
yarn-error.log
/.fleet
/.idea
/.nova
/.vscode
/.zed

# SQLite databases — never commit financial data
/database/*.sqlite
/database/*.sqlite-journal
/database/*.sqlite-shm
/database/*.sqlite-wal

# Uploaded statements — Plan 05 starts writing here
/storage/imports

# Raw ICS Cards PDF statements + raw PayPal Activity Download CSVs — never
# commit financial data. The extracted-and-redacted .txt fixture under
# Modules/Ingestion/tests/fixtures/ics/ics-sample-1.txt and the redacted
# PayPal CSV under Modules/Ingestion/tests/fixtures/paypal/paypal-sample-1.csv
# ARE committed; the raw .pdf / .csv lives here on the user's machine only.
/local/*
!/local/paypal/
/local/paypal/*
!/local/paypal/.gitkeep

# Module activation state — COMMITTED (not ignored): nwidart's FileActivator
# reads this at boot, and Tax's provider gates route registration on
# isEnabled(). When it was ignored, CI had no file, so `tax.index` never
# registered and every feature test rendering the app shell 500'd
# (RouteNotFoundException), blowing past the CI gate's time budget. Commit it so
# every checkout (CI, build, contributors) gets a deterministic module set.

# PHPStan cache
/.phpstan-cache

# NativePHP build + dist output — `native:build` stages the bundled app
# and electron-builder writes the packaged installers under base_path('build').
# Two committed exceptions, both static build inputs rather than artefacts:
# `entitlements.mac.plist` is the macOS Hardened Runtime file electron-builder
# references at signing time, and `notarize.js` is the afterSign hook staged
# over NativePHP's published one.
/build/*
!/build/entitlements.mac.plist
!/build/notarize.js

# NativePHP Electron working directory — `native:build` populates this with
# the Electron scaffold and writes `electron/dist/` build artefacts. It is
# regenerated on every build and must never be committed.
/nativephp

# macOS Finder metadata
.DS_Store

# Local-only planning corpus (PLAN.md / SUMMARY.md / workflow state / UAT specs /
# discussion logs / phase scratch). Kept on disk for the local GSD workflow tools;
# never tracked in public history — wave 7 of the v1.0 closeout series rewrote
# every prior commit to strip this directory.
.planning/

# Pint reuses this to skip files it has already seen unchanged; CI restores
# it between runs, where it takes the style check from ~175s to ~4s.
/.pint.cache

# Console logs and page snapshots dropped by the Playwright MCP server when
# it drives the app during local debugging.
/.playwright-mcp/

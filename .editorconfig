# Shared across the beatrax-app org. See beatrax-app/spec 40-quality/code-standards.md.
root = true

[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true
trim_trailing_whitespace = true
indent_style = space
indent_size = 2

[*.php]
indent_size = 4

[*.{js,ts,css}]
indent_size = 4

[*.{yml,yaml,json,jsonc}]
indent_size = 4

[*.md]
trim_trailing_whitespace = false

[Makefile]
indent_style = tab

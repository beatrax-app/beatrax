# Template loaded into the mobile bundle at build time, and the counterpart of
# the desktop root's own. Placeholder values only — first-launch regenerates
# APP_KEY via the bootstrap chain.
#
# It exists because staging a store build from .env.example shipped the
# development values of every key the two-line production rewrite did not
# touch: debug-level logging onto a phone, a daily log stack, and an APP_URL
# naming a host the bundle never serves.
APP_NAME=Beatrax
APP_ENV=production
APP_KEY=
APP_DEBUG=false
APP_TIMEZONE=UTC
APP_URL=http://127.0.0.1
APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=warning

DB_CONNECTION=sqlite

# 43200 minutes, matching the desktop bundle: the app lock is what ends a
# session on a phone, and a session that expires under it logs the reader out
# of an app they had locked rather than left.
SESSION_DRIVER=database
SESSION_LIFETIME=43200
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=null
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database

# database, not file: the phone's own cache store, kept where the desktop
# bundle deliberately differs — see an-id-read-after-an-insert.md for what a
# file store hid there.
CACHE_STORE=database
CACHE_LOCK_STORE=database

BEATRAX_DEV_MODE=false
BEATRAX_RUNTIME=bundle

NATIVEPHP_APP_ID=com.beatrax.mobile

MAIL_MAILER=log
MAIL_FROM_ADDRESS="hello@beatrax.test"
MAIL_FROM_NAME="${APP_NAME}"

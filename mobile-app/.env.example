# Mobile-app environment template.
#
# This root has its own .env: it is a SECOND Composer root, not a subdirectory
# of the first, so the repo-root .env.example does not describe it. Everything
# below is either read by mobile-app/config/nativephp.php or by the
# nativephp/mobile package's build and signing commands.
#
# The file exists because the keys kept disappearing. A re-minted .env silently
# lost the four ANDROID_KEYSTORE_* values that wired release signing, and left
# NATIVEPHP_APP_ID on the framework's placeholder — both of which fail quietly
# rather than loudly. Keep this list in step with the keys the build reads.
#
# NEVER commit real values here. Secrets live in the Beatrax 1Password vault;
# the "from" note on each key says which item to pull it from.
#
# The optional keys below are COMMENTED OUT, not left blank. An empty key is
# not an absent one: env('X', 'default') returns '' when X is present and
# empty, so a blank line here silently defeats the config default rather than
# deferring to it. Uncomment a key only when you are giving it a value.

APP_NAME=Beatrax
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_TIMEZONE=UTC
APP_URL=http://localhost

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file

LOG_CHANNEL=stack
LOG_STACK=daily
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=sqlite

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database
CACHE_STORE=database
CACHE_LOCK_STORE=database

MAIL_MAILER=log
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

VITE_APP_NAME="${APP_NAME}"

BEATRAX_DEV_MODE=false

# ── App identity ─────────────────────────────────────────────────────────────
# The one key that must be a real assignment rather than a commented default.
# native:install reads this FILE, not config(), and a commented or blank key
# does not satisfy it: it generates com.<user>.<random words>, writes that back,
# and the build ships under it — which is where com.wessel.stormlunarbold came
# from. com.beatrax.mobile is the App Store bundle id, the Play package name and
# what Bifrost builds under, so it is pinned here as well as in config.
NATIVEPHP_APP_ID=com.beatrax.mobile

# Absent, builds carry 0.0.0-dev / versionCode 1. Neither store accepts that,
# and nothing warns you before the upload is rejected.
#
# `php artisan native:release patch` does NOT set both, whatever it looks like.
# It writes NATIVEPHP_APP_VERSION only, and on a .env freshly copied from this
# template it writes nothing at all: it takes its "update the existing key"
# branch because the string matches inside the comment above, and that branch's
# regex needs a real assignment to replace. The file is written back unchanged
# with no error.
#
# For a release build there is nothing to do by hand: `mobile:package-android`
# derives the code from the version as major*10000 + minor*100 + patch and
# refuses to package if it cannot. Set it here only for `native:run` dev builds,
# which do not go through that command.
# NATIVEPHP_APP_VERSION=
# NATIVEPHP_APP_VERSION_CODE=

# Forces the shells to re-extract the PHP bundle on every launch by stamping
# the bundle id as the literal 'DEBUG'. Turn this ON for device development.
#
# Without it, `native:run` installs a new binary and keeps the PREVIOUSLY
# extracted PHP code: the update gate compares version+build, and both are
# pinned above, so they never differ between dev builds. The failure is silent
# and deeply misleading — on 2026-08-19 it presented as a whole-app 404 that
# survived restarts and matched no middleware, because the code executing was
# not the code being read. Leave it unset for anything you intend to ship.
# NATIVEPHP_DEBUG_BUNDLE=true

# NATIVEPHP_DEEPLINK_SCHEME=

# Only needed when the SDK is not at the platform default location.
# NATIVEPHP_ANDROID_SDK_LOCATION=

# ── iOS signing ──────────────────────────────────────────────────────────────
# Local development signing is Xcode-automatic and needs only the team id.
# from: 1Password → "beatrax iOS signing config (com.beatrax.mobile)" → Team ID
# IOS_TEAM_ID=

# Distribution (TestFlight / App Store) additionally needs the distribution
# certificate as a .p12. Quote the password: an unquoted # truncates it
# silently.
# from: 1Password → "beatrax iOS distribution .p12 (com.beatrax.mobile)"
#   and "beatrax iOS distribution .p12 — export password"
# IOS_DISTRIBUTION_CERTIFICATE_PATH=
# IOS_DISTRIBUTION_CERTIFICATE_PASSWORD=

# from: 1Password → "Beatrax signing cer + mobileprovision"
# IOS_DISTRIBUTION_PROVISIONING_PROFILE_PATH=

# App Store Connect API key, for `native:package ios --upload-to-app-store`.
# from: 1Password → "Key beatrax iOS signing config (com.beatrax.mobile)"
# APP_STORE_API_KEY_PATH=
# APP_STORE_API_KEY_ID=
# APP_STORE_API_ISSUER_ID=

# ── Android signing ──────────────────────────────────────────────────────────
# Without all four, a release build is UNSIGNED: the Gradle signingConfig is
# skipped entirely and `native:run --build=release` still reports success. Only
# the filename (app-release-unsigned.apk) gives it away.
# from: 1Password → "beatrax Android release keystore (app-release-key.jks)"
#       and "beatrax Android release keystore — signing config"
# ANDROID_KEYSTORE_FILE=
# ANDROID_KEYSTORE_PASSWORD=
# ANDROID_KEY_ALIAS=
# ANDROID_KEY_PASSWORD=

# Play Developer API service account, for `--upload-to-play-store`.
# GOOGLE_SERVICE_ACCOUNT_KEY=

# Optional: push notifications.
# FCM_SERVER_KEY=

# ── Sync ─────────────────────────────────────────────────────────────────────
# The port the phone dials on the paired desktop. It must match the desktop's
# own SYNC_PORT: this side reads config('sync.port') for the LAN leg, and a
# mismatch shows up as a relay-only sync that drains the mailbox and applies
# nothing ("0 of 0 records").
# SYNC_PORT=51337

{
    "name": "beatrax/beatrax-mobile",
    "type": "project",
    "description": "beatrax mobile peer — thin NativePHP-for-Mobile app shell over the shared Modules/ domain codebase.",
    "keywords": [
        "laravel",
        "personal-finance",
        "nativephp",
        "mobile"
    ],
    "license": "Hippocratic-3.0",
    "require": {
        "php": "^8.5",
        "ext-ctype": "*",
        "ext-filter": "*",
        "ext-iconv": "*",
        "ext-intl": "*",
        "ext-libxml": "*",
        "ext-mbstring": "*",
        "ext-pcntl": "*",
        "ext-pdo": "*",
        "ext-posix": "*",
        "ext-simplexml": "*",
        "composer-runtime-api": "^2.0",
        "amphp/http-server": "*",
        "amphp/socket": "*",
        "amphp/websocket-client": "*",
        "amphp/websocket-server": "*",
        "beatrax/mobile-biometric-vault": "*",
        "brick/math": "^0.14",
        "brick/money": "^0.11",
        "doctrine/sql-formatter": "^1.5",
        "dompdf/dompdf": "^3.0",
        "genkgo/camt": "^2.10",
        "google/apiclient": "^2.19",
        "google/apiclient-services": "*",
        "guzzlehttp/guzzle": "^7.8",
        "jschaedl/iban-validation": "^2.5",
        "laravel/fortify": "^1.21",
        "laravel/framework": "^13.0",
        "laravel/tinker": "^3.0",
        "league/csv": "^9.28",
        "league/oauth2-client": "^2.9",
        "league/oauth2-google": "^5.0",
        "livewire/flux": "^2.0",
        "livewire/livewire": "^4.0",
        "monolog/monolog": "^3.0",
        "nativephp/mobile": "^4.0",
        "nativephp/mobile-background-tasks": "0.0.4",
        "nativephp/mobile-biometrics": "1.0.3",
        "nativephp/mobile-local-notifications": "0.0.3",
        "nativephp/mobile-network": "*",
        "nativephp/mobile-scanner": "1.0.3",
        "nativephp/mobile-secure-storage": "*",
        "nativephp/mobile-ui": "^0.3",
        "nwidart/laravel-modules": "^13.0",
        "psr/log": "^3.0",
        "spatie/laravel-activitylog": "^5.0",
        "spatie/laravel-data": "^4.0",
        "spatie/pdf-to-text": "^1.0",
        "symfony/process": "^7.0",
        "symfony/yaml": "^8.0",
        "thenetworg/oauth2-azure": "^2.2",
        "zbateson/mail-mime-parser": "^4.0"
    },
    "conflict": {
        "webklex/laravel-imap": "*",
        "webklex/php-imap": "*",
        "ddeboer/imap": "*"
    },
    "autoload": {
        "psr-4": {
            "App\\": "app/",
            "Modules\\Auth\\": "Modules/Auth/",
            "Modules\\": "Modules/",
            "Database\\Factories\\": "database/factories/",
            "Database\\Seeders\\": "database/seeders/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Tests\\": "tests/",
            "Modules\\Mobile\\Tests\\": "Modules/Mobile/tests/",
            "Modules\\Sync\\Tests\\": "Modules/Sync/tests/"
        }
    },
    "scripts": {
        "pre-autoload-dump": [
            "Google\\Task\\Composer::cleanup"
        ],
        "post-autoload-dump": [
            "Illuminate\\Foundation\\ComposerScripts::postAutoloadDump",
            "@php artisan package:discover --ansi"
        ],
        "post-update-cmd": [
            "@php artisan native:install --with-icu --quiet",
            "@php ../scripts/nativephp_grant_webview_camera.php",
            "@php ../scripts/nativephp_android_file_chooser.php",
            "@php ../scripts/nativephp_keep_webview_cookies.php",
            "@php ../scripts/nativephp_theme_native_shell.php",
            "@php ../scripts/nativephp_brand_boot_splash.php",
            "@php ../scripts/nativephp_android_adaptive_icon.php",
            "@php ../scripts/nativephp_ios_app_icon.php",
            "@php ../scripts/nativephp_extend_bundle_copy_timeout.php"
        ],
        "native:patch": [
            "@php ../scripts/nativephp_android_adaptive_icon.php",
            "@php ../scripts/nativephp_ios_app_icon.php",
            "@php ../scripts/nativephp_grant_webview_camera.php",
            "@php ../scripts/nativephp_android_file_chooser.php",
            "@php ../scripts/nativephp_keep_webview_cookies.php",
            "@php ../scripts/nativephp_theme_native_shell.php"
        ]
    },
    "extra": {
        "laravel": {
            "dont-discover": [
                "laravel/horizon"
            ]
        },
        "google/apiclient-services": [
            "Gmail"
        ]
    },
    "config": {
        "optimize-autoloader": true,
        "preferred-install": "dist",
        "sort-packages": true,
        "license-validation": false,
        "platform": {
            "ext-pcntl": "8.5",
            "ext-posix": "8.5"
        },
        "allow-plugins": {
            "pestphp/pest-plugin": true,
            "php-http/discovery": true,
            "tbachert/spi": true,
            "wikimedia/composer-merge-plugin": true
        }
    },
    "minimum-stability": "stable",
    "prefer-stable": true,
    "repositories": [
        {
            "name": "nativephp-plugins",
            "type": "composer",
            "url": "https://plugins.nativephp.com"
        },
        {
            "type": "path",
            "url": "nativephp-plugins/biometric-vault",
            "options": {
                "symlink": true
            }
        }
    ],
    "require-dev": {
        "fakerphp/faker": "^1.23",
        "mockery/mockery": "^1.6",
        "pestphp/pest": "^4.0",
        "pestphp/pest-plugin-laravel": "^4.0"
    }
}

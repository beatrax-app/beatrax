# Mobile-app root ignores.
#
# The mobile shell has its OWN vendor/ tree (carries nativephp/mobile, which
# conflicts with the desktop root's nativephp/desktop — the whole reason this
# sibling root exists). Never commit it, the env, or any native platform
# scaffold that `native:install` generates.

/vendor
.env
.env.backup
.env.bak
.env.production
/node_modules

# Laravel-generated bootstrap caches — regenerated per environment, must never
# be committed (a dev-tree cache references providers absent from a --no-dev
# bundle and fatals at boot).
/bootstrap/cache/*.php

# Runtime storage
/storage/framework/cache/*
!/storage/framework/cache/.gitignore
/storage/framework/sessions/*
!/storage/framework/sessions/.gitignore
/storage/framework/testing/*
!/storage/framework/testing/.gitignore
/storage/framework/views/*
!/storage/framework/views/.gitignore
/storage/logs/*
!/storage/logs/.gitignore
/storage/*.key

# NativePHP-for-Mobile platform scaffolds. `native:install` / `native:run`
# generate large native iOS (Xcode) + Android (Gradle) project trees plus a
# working dir; these are hundreds of MB, machine-specific, and regenerated on
# demand — never committed. `native:install` also emits the `native` CLI
# wrapper and `nativephp.lock` (records the bundled PHP binary version); both
# are regenerated by `native:install`, so they are ignored too.
/nativephp
/nativephp.lock
/native
/ios
/android
/build

.DS_Store

{
    "namespace": "BiometricVault",
    "bridge_functions": [
        {
            "name": "BiometricVault.Set",
            "android": "com.beatrax.biometricvault.BiometricVaultFunctions.Set",
            "ios": "BiometricVaultFunctions.Set",
            "description": "Store a value in a biometric-gated keychain/keystore entry"
        },
        {
            "name": "BiometricVault.Get",
            "android": "com.beatrax.biometricvault.BiometricVaultFunctions.Get",
            "ios": "BiometricVaultFunctions.Get",
            "description": "Read a value, releasing it ONLY after a fresh biometric authentication"
        },
        {
            "name": "BiometricVault.PollRecovered",
            "android": "com.beatrax.biometricvault.BiometricVaultFunctions.PollRecovered",
            "ios": "BiometricVaultFunctions.PollRecovered",
            "description": "Hand over the blob the biometric prompt released, once, and only to the slot key it was released from"
        },
        {
            "name": "BiometricVault.CancelPrompt",
            "android": "com.beatrax.biometricvault.BiometricVaultFunctions.CancelPrompt",
            "ios": "BiometricVaultFunctions.CancelPrompt",
            "description": "Stand down: take down a standing prompt and drop any blob one already released"
        },
        {
            "name": "BiometricVault.IsAvailable",
            "android": "com.beatrax.biometricvault.BiometricVaultFunctions.IsAvailable",
            "android_params": [
                "context"
            ],
            "ios": "BiometricVaultFunctions.IsAvailable",
            "description": "Whether this device can gate an entry behind a biometric right now"
        },
        {
            "name": "BiometricVault.Delete",
            "android": "com.beatrax.biometricvault.BiometricVaultFunctions.Delete",
            "ios": "BiometricVaultFunctions.Delete",
            "description": "Delete a biometric-gated entry"
        }
    ],
    "android": {
        "min_version": 30,
        "permissions": [
            "android.permission.USE_BIOMETRIC"
        ],
        "dependencies": {
            "implementation": [
                "androidx.biometric:biometric:1.1.0"
            ]
        }
    },
    "ios": {
        "min_version": "18.2",
        "info_plist": {
            "NSFaceIDUsageDescription": "Unlock Beatrax with Face ID"
        },
        "dependencies": {
            "swift_packages": [],
            "pods": []
        }
    },
    "events": [
        "BiometricVault.Recovered",
        "BiometricVault.Failed"
    ]
}

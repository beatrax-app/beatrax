# Template loaded into the desktop bundle at build time. Placeholder values only — first-launch regenerates APP_KEY via the bootstrap chain.
APP_NAME=beatrax
APP_ENV=production
APP_KEY=
APP_DEBUG=false
APP_TIMEZONE=Europe/Amsterdam
APP_URL=http://127.0.0.1
APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=warning

DB_CONNECTION=sqlite

SESSION_DRIVER=database
SESSION_LIFETIME=43200
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=null
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database

CACHE_STORE=file
CACHE_LOCK_STORE=database

BEATRAX_DEV_MODE=false
BEATRAX_RUNTIME=bundle

# The sync listener and the opt-in relay endpoint. Commented out so the bundle
# defers to the config default rather than pinning a second copy of it; a user
# on a network that blocks these ports uncomments and changes them.
# SYNC_PORT=51337
# SYNC_RELAY_PORT=51338

MAIL_MAILER=log
MAIL_FROM_ADDRESS="hello@beatrax.test"
MAIL_FROM_NAME="${APP_NAME}"

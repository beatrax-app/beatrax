APP_NAME=Beatrax
APP_ENV=local
APP_KEY=
APP_DEBUG=true
# APP_TIMEZONE is deliberately unset. Left pinned, a bundle ships one
# zone to every reader who installs it; unset, InstallTimezone reads the
# machine, and a stored choice in settings overrides that. Setting it here
# takes precedence over both, which is what a server deployment wants.
APP_URL=https://beatrax.test

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file

LOG_CHANNEL=stack
LOG_STACK=daily
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

# SQLite, in every deployment shape — desktop bundle, mobile shell and
# self-hosted server alike (ADR-0022). Thirty-two migrations use SQLite-only
# enum-guard triggers and search is an FTS5 virtual table, so `migrate` against
# a server database fails on the first substantive table. There is no host,
# port, username or password to set here.
DB_CONNECTION=sqlite

SESSION_DRIVER=database
SESSION_LIFETIME=43200
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database

# `file` (not `database`): NativePHP runs `php artisan optimize` during
# PHP-server startup, which fires Spatie laravel-data's data-structure
# cache write. On a first launch the user-data SQLite has not yet been
# migrated by FirstLaunchBootstrap, so a `database` cache store would
# fail with "no such table: cache" on every fresh install / post-update.
# The file driver writes under the NativePHP-redirected storage dir
# and has no migration dependency.
CACHE_STORE=file
# Unique-job locks still go through the database cache_locks table
# (Phase 14 D-02): this is acquired at job-dispatch time, never during
# optimize, so the first-launch race above does not apply.
CACHE_LOCK_STORE=database

# Enables developer-only features such as the Horizon dashboard. Shipped
# builds leave this false; the developer's box sets it to true.
BEATRAX_DEV_MODE=false

# Redis is not used by a shipped build — the database queue and cache
# lock store need no Redis daemon, and predis is a require-dev package.
# These keys are only relevant on the developer's local dev box, where
# CACHE_LOCK_STORE=redis / QUEUE_CONNECTION=redis select the Redis
# connection. REDIS_PASSWORD stays null because the listener binds to
# 127.0.0.1 only and is never exposed to the LAN.
# REDIS_CLIENT=predis
# REDIS_HOST=127.0.0.1
# REDIS_PORT=6379
# REDIS_PASSWORD=null

MAIL_MAILER=log
MAIL_FROM_ADDRESS="hello@beatrax.test"
MAIL_FROM_NAME="${APP_NAME}"

# Port the OAuth callback listener binds to on the loopback IP. The
# wizard prints http://127.0.0.1:{OAUTH_LOOPBACK_PORT}/oauth/callback/{provider}
# for the user to paste into Google Cloud Console / Azure Portal.
# Set this when serving the app on a host that providers reject as a
# redirect URI (e.g. a `.test` domain on 443/80); the OAuth callback then
# has to be served via `php artisan serve --port=8000` in a separate
# terminal. Leave unset to fall back to
# parsing app.url for the port when its host is 127.0.0.1/localhost,
# otherwise the default port 8000 is used.
# OAUTH_LOOPBACK_PORT=8000

# Ports the two sync daemons bind, and the port a paired phone dials back on.
# SYNC_PORT is what `sync:serve` listens on and what peers advertise over mDNS;
# SYNC_RELAY_PORT is what the opt-in `relay:serve` endpoint binds. Change them
# when the defaults are taken or a network blocks them — every listener,
# spawner and dialler reads these, so both ends move together.
# SYNC_PORT=51337
# SYNC_RELAY_PORT=51338

# Origin the desktop updater's Ed25519 pre-check fetches the signed publisher
# manifest from before any download or install (read as
# config('auto_update.manifest_feed_url')). Left unset here on purpose: the
# `release` workflow appends the value derived from the GitHub context
# (https://github.com/<owner>/<repo>/releases/latest/download) to the bundled
# .env at build time, so dev and web installs never poll a feed. Set it only to
# point a self-hosted desktop build at a different GitHub Releases origin.
# AUTO_UPDATE_FEED_URL=https://github.com/<owner>/<repo>/releases/latest/download

# Whether this BUILD carries an update feed at all. Two readers, one name:
# electron-builder.mjs compares it to the string 'true' and only then writes the
# `publish` block that puts `app-update.yml` in the bundle, while
# config('nativephp.updater.enabled') is what the Electron boot hook checks
# before polling. Left unset here on purpose — a local `native:build` has no
# GITHUB_OWNER/GITHUB_REPO to publish against — and set to 'true' by the
# `release` workflow on both sides at once. Whether a launch actually polls is
# then narrowed by the reader's own switch in Settings, never by this.
# NATIVEPHP_UPDATER_ENABLED=true

# The interfaces a self-hosted install serves on beyond loopback, compared
# against the bind address the SAPI publishes. Unset — the shipped default, and
# what every desktop and mobile build ships with — refuses every non-loopback
# request with not-found. Only literal IP addresses count; a hostname, a CIDR
# range and the wildcards 0.0.0.0 / :: are ignored and reported by
# `beatrax:doctor`, because this names interfaces and must not spell
# "everything". Where the runtime publishes no bind address (FrankenPHP, and
# `artisan serve`) a remote request is authorised by APP_URL's host instead, so
# that host has to name something other than localhost. See .docs/deployment.md.
# BEATRAX_SERVED_INTERFACES=192.168.1.50

VITE_APP_NAME="${APP_NAME}"

{
    "name": "beatrax/beatrax",
    "type": "project",
    "description": "Local-only personal finance dashboard.",
    "keywords": [
        "laravel",
        "personal-finance",
        "localhost"
    ],
    "license": "Hippocratic-3.0",
    "require": {
        "php": "^8.5",
        "ext-ctype": "*",
        "ext-filter": "*",
        "ext-iconv": "*",
        "ext-intl": "*",
        "ext-libxml": "*",
        "ext-mbstring": "*",
        "ext-openssl": "*",
        "ext-pcntl": "*",
        "ext-pdo": "*",
        "ext-posix": "*",
        "ext-simplexml": "*",
        "composer-runtime-api": "^2.0",
        "amphp/http-server": "*",
        "amphp/socket": "*",
        "amphp/websocket-client": "*",
        "amphp/websocket-server": "*",
        "brick/math": "^0.18",
        "brick/money": "^0.14",
        "doctrine/sql-formatter": "^1.5",
        "dompdf/dompdf": "^3.0",
        "firebase/php-jwt": "^7.1",
        "genkgo/camt": "^2.10",
        "google/apiclient": "^2.19",
        "google/apiclient-services": "*",
        "guzzlehttp/guzzle": "^7.8",
        "jschaedl/iban-validation": "^2.5",
        "laravel/fortify": "^1.21",
        "laravel/framework": "^13.0",
        "laravel/tinker": "^3.0",
        "league/csv": "^9.28",
        "league/oauth2-client": "^2.9",
        "league/oauth2-google": "^5.0",
        "livewire/flux": "^2.0",
        "livewire/livewire": "^4.0",
        "monolog/monolog": "^3.0",
        "nativephp/desktop": "^2.2",
        "nwidart/laravel-modules": "^13.0",
        "psr/log": "^3.0",
        "spatie/laravel-activitylog": "^5.0",
        "spatie/laravel-data": "^4.0",
        "spatie/pdf-to-text": "^1.0",
        "symfony/process": "^8.1",
        "symfony/yaml": "^8.0",
        "thenetworg/oauth2-azure": "^2.2",
        "zbateson/mail-mime-parser": "^4.0"
    },
    "conflict": {
        "webklex/laravel-imap": "*",
        "webklex/php-imap": "*",
        "ddeboer/imap": "*",
        "laravel/framework": ">=13.24"
    },
    "require-dev": {
        "calebdw/larastan-livewire": "^2.0",
        "canvural/larastan-strict-rules": "^3.0",
        "fakerphp/faker": "^1.23",
        "larastan/larastan": "^3.0",
        "laravel/horizon": "^5.46",
        "laravel/pint": "^1.18",
        "maglnet/composer-require-checker": "^4",
        "mockery/mockery": "^1.6",
        "pestphp/pest": "^5.0",
        "pestphp/pest-plugin-arch": "^5.0",
        "pestphp/pest-plugin-laravel": "^5.0",
        "phpstan/phpstan-strict-rules": "^2.0",
        "predis/predis": "^3.4",
        "spatie/pest-plugin-snapshots": "^2.0"
    },
    "autoload": {
        "psr-4": {
            "App\\": "app/",
            "Modules\\Auth\\": "Modules/Auth/",
            "Modules\\": "Modules/",
            "Database\\Factories\\": "database/factories/",
            "Database\\Seeders\\": "database/seeders/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Tests\\": "tests/",
            "Modules\\Anomaly\\Tests\\": "Modules/Anomaly/tests/",
            "Modules\\Auth\\Tests\\": "Modules/Auth/tests/",
            "Modules\\Budgets\\Tests\\": "Modules/Budgets/tests/",
            "Modules\\Calendar\\Tests\\": "Modules/Calendar/tests/",
            "Modules\\Goals\\Tests\\": "Modules/Goals/tests/",
            "Modules\\Pots\\Tests\\": "Modules/Pots/tests/",
            "Modules\\CashBook\\Tests\\": "Modules/CashBook/tests/",
            "Modules\\Core\\Tests\\": "Modules/Core/tests/",
            "Modules\\Desktop\\Tests\\": "Modules/Desktop/tests/",
            "Modules\\DevMode\\Tests\\": "Modules/DevMode/tests/",
            "Modules\\Ledger\\Tests\\": "Modules/Ledger/tests/",
            "Modules\\Migration\\Tests\\": "Modules/Migration/tests/",
            "Modules\\Ingestion\\Tests\\": "Modules/Ingestion/tests/",
            "Modules\\Import\\Tests\\": "Modules/Import/tests/",
            "Modules\\Onboarding\\Tests\\": "Modules/Onboarding/tests/",
            "Modules\\Categorization\\Tests\\": "Modules/Categorization/tests/",
            "Modules\\Chains\\Tests\\": "Modules/Chains/tests/",
            "Modules\\Counterparties\\Tests\\": "Modules/Counterparties/tests/",
            "Modules\\Community\\Tests\\": "Modules/Community/tests/",
            "Modules\\DriftAlerts\\Tests\\": "Modules/DriftAlerts/tests/",
            "Modules\\EmailScan\\Tests\\": "Modules/EmailScan/tests/",
            "Modules\\Forecasting\\Tests\\": "Modules/Forecasting/tests/",
            "Modules\\Receipts\\Tests\\": "Modules/Receipts/tests/",
            "Modules\\FX\\Tests\\": "Modules/FX/tests/",
            "Modules\\Recurring\\Tests\\": "Modules/Recurring/tests/",
            "Modules\\Transfers\\Tests\\": "Modules/Transfers/tests/",
            "Modules\\Tax\\Tests\\": "Modules/Tax/tests/",
            "Modules\\Search\\Tests\\": "Modules/Search/tests/",
            "Modules\\Sync\\Tests\\": "Modules/Sync/tests/",
            "Modules\\Mobile\\Tests\\": "Modules/Mobile/tests/",
            "Modules\\Reports\\Tests\\": "Modules/Reports/tests/",
            "Modules\\Notifications\\Tests\\": "Modules/Notifications/tests/",
            "Modules\\Position\\Tests\\": "Modules/Position/tests/",
            "Modules\\OpenBanking\\Tests\\": "Modules/OpenBanking/tests/"
        }
    },
    "scripts": {
        "pre-autoload-dump": [
            "Google\\Task\\Composer::cleanup"
        ],
        "post-autoload-dump": [
            "Illuminate\\Foundation\\ComposerScripts::postAutoloadDump",
            "@php artisan package:discover --ansi"
        ],
        "test": [
            "@putenv PHP_INI_SCAN_DIR=:tools/test-php-ini",
            "pest --parallel --processes=4"
        ],
        "test:tia": [
            "@putenv PHP_INI_SCAN_DIR=:tools/test-php-ini",
            "pest --parallel --processes=4 --tia --passthru-php=\"-d pcov.enabled=1\""
        ],
        "test:coverage": "pest --parallel --processes=4 --coverage",
        "analyse": "phpstan analyse --memory-limit=1G",
        "format": "pint",
        "format:check": "pint --test",
        "dev:seed": [
            "@php artisan migrate --force",
            "@php artisan demo:seed --reset"
        ],
        "dev:seed-desktop": [
            "@putenv NATIVEPHP_RUNNING=true",
            "@php artisan migrate --force",
            "@php artisan demo:seed --reset"
        ],
        "dev:serve": [
            "Composer\\Config::disableProcessTimeout",
            "npx concurrently -k -c \"#93c5fd,#c4b5fd\" \"php artisan serve --host=127.0.0.1 --port=8000\" \"npm run dev\" --names=app,vite"
        ],
        "check:paths": "bash bin/check-paths.sh",
        "native:dev": [
            "Composer\\Config::disableProcessTimeout",
            "npx concurrently -k -c \"#93c5fd,#c4b5fd\" \"php artisan native:run --no-interaction\" \"npm run dev\" --names=app,vite"
        ],
        "post-update-cmd": [
            "@php artisan native:install --force --quiet --publish"
        ]
    },
    "scripts-descriptions": {
        "test": "The gate: every test, no result reuse. Run this before handing work back.",
        "test:tia": "Iteration only. Pest replays tests your changes cannot have affected from its cache and re-runs the rest, so it is only faster than `test` when few files differ from origin/main — on a large branch it runs everything anyway and pays for coverage recording on top. TIA also refuses partial runs: passing a path, --filter or --testsuite disables it, so scope by module with `pest <path>` instead. Never use it as the gate; a replayed pass is a cached pass.",
        "test:coverage": "Full suite with pcov, writing the clover report SonarCloud reads.",
        "analyse": "PHPStan level 10, including the beatrax.boundary rule.",
        "format:check": "Pint in --test mode; use `format` to apply."
    },
    "extra": {
        "laravel": {
            "dont-discover": [
                "laravel/horizon"
            ]
        },
        "google/apiclient-services": [
            "Gmail"
        ]
    },
    "config": {
        "optimize-autoloader": true,
        "preferred-install": "dist",
        "sort-packages": true,
        "license-validation": false,
        "platform": {
            "ext-pcntl": "8.5",
            "ext-posix": "8.5"
        },
        "allow-plugins": {
            "pestphp/pest-plugin": true,
            "php-http/discovery": true,
            "tbachert/spi": true,
            "wikimedia/composer-merge-plugin": true
        }
    },
    "minimum-stability": "stable",
    "prefer-stable": true
}

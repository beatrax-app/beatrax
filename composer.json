{
    "name": "diederik/diederik",
    "type": "project",
    "description": "Local-only personal finance dashboard.",
    "keywords": ["laravel", "personal-finance", "localhost"],
    "license": "proprietary",
    "require": {
        "php": "^8.5",
        "laravel/framework": "^13.0",
        "laravel/fortify": "^1.21",
        "livewire/livewire": "^4.0",
        "livewire/flux": "^2.0",
        "nwidart/laravel-modules": "^13.0",
        "brick/money": "^0.11",
        "league/csv": "^9.28",
        "spatie/laravel-data": "^4.0"
    },
    "require-dev": {
        "pestphp/pest": "^4.0",
        "pestphp/pest-plugin-laravel": "^4.0",
        "pestphp/pest-plugin-arch": "^4.0",
        "spatie/pest-plugin-snapshots": "^2.0",
        "larastan/larastan": "^3.0",
        "calebdw/larastan-livewire": "^2.0",
        "canvural/larastan-strict-rules": "^3.0",
        "laravel/pint": "^1.18",
        "fakerphp/faker": "^1.23",
        "symfony/process": "^7.0",
        "mockery/mockery": "^1.6"
    },
    "autoload": {
        "psr-4": {
            "App\\": "app/",
            "Modules\\": "Modules/",
            "Database\\Factories\\": "database/factories/",
            "Database\\Seeders\\": "database/seeders/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Tests\\": "tests/",
            "Modules\\Core\\Tests\\": "Modules/Core/tests/",
            "Modules\\Ledger\\Tests\\": "Modules/Ledger/tests/",
            "Modules\\Ingestion\\Tests\\": "Modules/Ingestion/tests/",
            "Modules\\Import\\Tests\\": "Modules/Import/tests/",
            "Modules\\Categorization\\Tests\\": "Modules/Categorization/tests/"
        }
    },
    "scripts": {
        "test": "pest --parallel",
        "analyse": "phpstan analyse --memory-limit=1G",
        "format": "pint",
        "format:check": "pint --test"
    },
    "extra": {
        "laravel": {
            "dont-discover": []
        }
    },
    "config": {
        "optimize-autoloader": true,
        "preferred-install": "dist",
        "sort-packages": true,
        "allow-plugins": {
            "pestphp/pest-plugin": true,
            "php-http/discovery": true,
            "wikimedia/composer-merge-plugin": true
        }
    },
    "minimum-stability": "stable",
    "prefer-stable": true
}

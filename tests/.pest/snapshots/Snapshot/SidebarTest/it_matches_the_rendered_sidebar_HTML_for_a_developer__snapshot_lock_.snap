<aside wire:name="core.app-sidebar" class="side" aria-label="Primary" style="--side-w: 248px;">
    <div class="side-brand">
        <img src="https://beatrax.test/build/assets/logo.svg" alt="Beatrax" width="24" height="24" class="logo logo-svg" />
        <span>Beatrax</span>
        
        <span class="version-chip">v0.0.0-dev</span>
    </div>

    
    <div
        class="side-search"
        role="search"
        x-on:click="window.Livewire && window.Livewire.dispatch('palette:open')"
        style="cursor: pointer;"
    >
        <svg
    class="h-5 w-5 ic"
    fill="none"
    viewBox="0 0 24 24"
    stroke="currentColor"
    stroke-width="2"
    aria-hidden="true"
>
    <path stroke-linecap="round" stroke-linejoin="round" d="M21 21l-4.35-4.35M17 11a6 6 0 11-12 0 6 6 0 0112 0z" />
</svg>
        <input
            type="text"
            placeholder="Search…"
            aria-label="Open search palette"
            readonly
            x-on:focus="window.Livewire && window.Livewire.dispatch('palette:open')"
            style="cursor: pointer;"
        />
        
        <span
            class="kbd hidden-touch max-lg:hidden"
            aria-hidden="true"
            x-text="$store.platform.isMac ? '\u2318K' : 'Ctrl+K'"
        >Ctrl+K</span>
    </div>

    <div class="side-section-label">OVERVIEW</div>
    
    <a href="https://beatrax.test" class="side-item ">
        <span class="ic" aria-hidden="true">◆</span>
        Dashboard
    </a>
    <a href="https://beatrax.test/transactions" class="side-item ">
        <span class="ic" aria-hidden="true">≡</span>
        Transactions
        <!--[if BLOCK]><![endif]--><!--[if ENDBLOCK]><![endif]-->    </a>
    
    <a href="https://beatrax.test/forecast" class="side-item ">
        <span class="ic" aria-hidden="true">↗</span>
        Forecasts
        <!--[if BLOCK]><![endif]--><!--[if ENDBLOCK]><![endif]-->    </a>
    <a href="https://beatrax.test/calendar" class="side-item ">
        <span class="ic" aria-hidden="true">▦</span>
        Calendar
    </a>
    
    <a href="https://beatrax.test/notifications" class="side-item ">
        <span class="ic" aria-hidden="true">◈</span>
        Notifications
        <!--[if BLOCK]><![endif]--><!--[if ENDBLOCK]><![endif]-->    </a>

    
    <div class="side-section-label">COMMITMENTS</div>
    <a href="https://beatrax.test/recurring" class="side-item ">
        <span class="ic" aria-hidden="true">↻</span>
        Recurring
        <!--[if BLOCK]><![endif]--><!--[if ENDBLOCK]><![endif]-->    </a>
    <a href="https://beatrax.test/drift/watch" class="side-item ">
        <span class="ic" aria-hidden="true">▷</span>
        Subscriptions
        <!--[if BLOCK]><![endif]--><!--[if ENDBLOCK]><![endif]-->    </a>
    
    
    <a href="https://beatrax.test/chains" class="side-item ">
        <span class="ic" aria-hidden="true">⇉</span>
        Chains
        <!--[if BLOCK]><![endif]--><!--[if ENDBLOCK]><![endif]-->    </a>
    
    <a href="https://beatrax.test/drift?type=anomaly" class="side-item">
        <span class="ic" aria-hidden="true">◬</span>
        Unusual charges
        <!--[if BLOCK]><![endif]--><!--[if ENDBLOCK]><![endif]-->    </a>
    <a href="https://beatrax.test/drift" class="side-item ">
        <span class="ic" aria-hidden="true">⚠</span>
        Drift alerts
        <!--[if BLOCK]><![endif]--><!--[if ENDBLOCK]><![endif]-->    </a>

    
    <div class="side-section-label">PLANNING</div>
    <a href="https://beatrax.test/budgets" class="side-item ">
        <span class="ic" aria-hidden="true">⊙</span>
        Budgets
        <!--[if BLOCK]><![endif]--><!--[if ENDBLOCK]><![endif]-->    </a>
    
    <a href="https://beatrax.test/tax" class="side-item ">
        <span class="ic" aria-hidden="true">⊞</span>
        Tax
        <!--[if BLOCK]><![endif]--><!--[if ENDBLOCK]><![endif]-->    </a>
    <a href="https://beatrax.test/goals" class="side-item ">
        <span class="ic" aria-hidden="true">◎</span>
        Goals
    </a>
    <a href="https://beatrax.test/pots" class="side-item ">
        <span class="ic" aria-hidden="true">◫</span>
        Pots
    </a>

    
    <div class="side-section-label">INSIGHTS</div>
    
    <a href="https://beatrax.test/reports" class="side-item ">
        <span class="ic" aria-hidden="true">▤</span>
        Reports
    </a>
    
    <a href="https://beatrax.test/reconcile" class="side-item ">
        <span class="ic" aria-hidden="true">✓</span>
        Reconcile
    </a>

    <div class="side-section-label">DATA IN</div>
    <a href="https://beatrax.test/imports/new" class="side-item ">
        <span class="ic" aria-hidden="true">⊕</span>
        Imports
        <!--[if BLOCK]><![endif]--><!--[if ENDBLOCK]><![endif]-->    </a>
    
    <a href="https://beatrax.test/cash" class="side-item ">
        <span class="ic" aria-hidden="true">€</span>
        Cash book
    </a>
    
    <a href="https://beatrax.test/inboxes" class="side-item ">
        <span class="ic" aria-hidden="true">✉</span>
        Email
        <!--[if BLOCK]><![endif]--><!--[if ENDBLOCK]><![endif]-->    </a>

    
    <div class="side-section-label">ORGANISE</div>
    
    <a href="https://beatrax.test/counterparties" class="side-item ">
        <span class="ic" aria-hidden="true">◉</span>
        Counterparties
        <!--[if BLOCK]><![endif]--><!--[if ENDBLOCK]><![endif]-->    </a>
    
    <a href="https://beatrax.test/counterparties/triage" class="side-item ">
        <span class="ic" aria-hidden="true">❋</span>
        Triage
        <!--[if BLOCK]><![endif]--><!--[if ENDBLOCK]><![endif]-->    </a>
    <a href="https://beatrax.test/uncategorized" class="side-item ">
        <span class="ic" aria-hidden="true">⌕</span>
        Categorization
    </a>
    <a href="https://beatrax.test/community" class="side-item ">
        <span class="ic" aria-hidden="true">◇</span>
        Community
    </a>

    <div class="side-section-label">SETTINGS</div>
    
    <a href="https://beatrax.test/data-devices" class="side-item ">
        <span class="ic" aria-hidden="true">
            <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" class="h-4 w-4" aria-hidden="true">
                <path stroke-linecap="round" stroke-linejoin="round" d="M16.023 9.348h4.992v-.001M2.985 19.644v-4.992m0 0h4.992m-4.993 0 3.181 3.183a8.25 8.25 0 0 0 13.803-3.7M4.031 9.865a8.25 8.25 0 0 1 13.803-3.7l3.181 3.182m0-4.991v4.99" />
            </svg>
        </span>
        Data &amp; devices
    </a>
    <a href="https://beatrax.test/settings" class="side-item ">
        <span class="ic" aria-hidden="true">⚙</span>
        Settings
    </a>

    <div class="side-foot">
        <!--[if BLOCK]><![endif]-->            
            <div class="side-dev-block">
                <div class="heading">
                    <span class="dot-live" aria-hidden="true"></span>
                    Developer
                </div>
                <a href="/dev" class="side-item">
                    <span class="ic" aria-hidden="true">›_</span>
                    Open Dev Console
                    
                    <span
                        class="kbd hidden-touch max-lg:hidden"
                        aria-hidden="true"
                        x-text="$store.platform.isMac ? '\u2318.' : 'Ctrl+.'"
                    >Ctrl+.</span>
                </a>
                
                <div class="dev-pulse"  wire:poll.5s.keep-alive >
                    Queue 0 · Worker —
                </div>
            </div>
        <!--[if ENDBLOCK]><![endif]-->
        
        <div class="side-account">
            <div class="avatar" aria-hidden="true">S</div>
            <div>
                <span class="name">snap-dev</span>
                <span class="caption">developer · local</span>
            </div>
            <span class="ic right" aria-hidden="true">⋯</span>
        </div>

        <form method="POST" action="https://beatrax.test/logout" data-beatrax-post x-data x-on:submit.prevent="beatraxSubmitPostForm($el, $event.submitter)">
                        <button type="submit" class="side-item" style="width: 100%;">
                
                <span class="ic" aria-hidden="true">
                    <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" class="h-4 w-4" aria-hidden="true">
                        <path stroke-linecap="round" stroke-linejoin="round" d="M8.25 9V5.25A2.25 2.25 0 0 1 10.5 3h6a2.25 2.25 0 0 1 2.25 2.25v13.5A2.25 2.25 0 0 1 16.5 21h-6a2.25 2.25 0 0 1-2.25-2.25V15m-3 0-3-3m0 0 3-3m-3 3H15" />
                    </svg>
                </span>
                Sign out
            </button>
        </form>
    </div>
</aside>
